# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------


@dataclasses.dataclass
class Hunk:
    hid: str                  # "H1", "H2", ...
    file: str                 # new path (or old path for deletions)
    file_status: str          # modified | added | deleted | renamed
    header: str               # "@@ -a,b +c,d @@ ..." line
    body: str                 # hunk lines incl. header
    new_start: int = 0
    new_count: int = 0
    added: int = 0
    removed: int = 0
    # scoring
    importance: Optional[int] = None
    category: str = ""
    reason: str = ""          # compact one-liner (verdict, or heuristic rationale)
    what: str = ""            # what the change does
    why: str = ""             # why it is needed in this PR
    tests: str = ""           # testing/coverage signal for this hunk
    blast: str = ""           # blast radius if this hunk is wrong
    verdict: str = ""         # overall impression of the diff
    heuristic: bool = False   # scored by a local rule, not the model

    @property
    def line_range(self) -> str:
        if not self.header:
            return "meta"
        if self.new_count:
            return f"{self.new_start}-{self.new_start + self.new_count - 1}"
        if self.new_start == 0:
            return "deleted"
        return f"after {self.new_start}"


@dataclasses.dataclass
class FileDiff:
    old_path: str
    new_path: str
    is_binary: bool = False
    is_rename: bool = False
    is_copy: bool = False
    is_new: bool = False
    is_deleted: bool = False
    old_mode: str = ""
    new_mode: str = ""
    hunks: list = dataclasses.field(default_factory=list)

    @property
    def status(self) -> str:
        if self.is_new:
            return "added"
        if self.is_deleted:
            return "deleted"
        if self.is_rename:
            return "renamed"
        if self.is_copy:
            return "copied"
        return "modified"

    @property
    def display_path(self) -> str:
        if (self.is_rename or self.is_copy) and self.old_path != self.new_path:
            return f"{self.old_path} -> {self.new_path}"
        return self.new_path if not self.is_deleted else self.old_path


