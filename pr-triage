class C:
    enabled = True

    @classmethod
    def _c(cls, code: str, s: str) -> str:
        return f"\033[{code}m{s}\033[0m" if cls.enabled else s

    @classmethod
    def bold(cls, s): return cls._c("1", s)
    @classmethod
    def dim(cls, s): return cls._c("2", s)
    @classmethod
    def red(cls, s): return cls._c("31", s)
    @classmethod
    def green(cls, s): return cls._c("32", s)
    @classmethod
    def yellow(cls, s): return cls._c("33", s)
    @classmethod
    def blue(cls, s): return cls._c("34", s)
    @classmethod
    def magenta(cls, s): return cls._c("35", s)
    @classmethod
    def cyan(cls, s): return cls._c("36", s)
    @classmethod
    def bold_red(cls, s): return cls._c("1;31", s)
    @classmethod
    def bold_yellow(cls, s): return cls._c("1;33", s)
    @classmethod
    def bold_green(cls, s): return cls._c("1;32", s)


def score_color(score: Optional[int]):
    if score is None:
        return C.dim
    if score >= 80:
        return C.bold_red
    if score >= 60:
        return C.bold_yellow
    if score >= 40:
        return C.cyan
    return C.dim


LOG_PATH = os.path.expanduser("~/.local/state/pr-triage/serve.log")
_ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
_log_fh = None


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)
    if _log_fh is not None:
        try:
            msg = _ANSI_RE.sub("", " ".join(str(a) for a in args))
            _log_fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n")
            _log_fh.flush()
        except OSError:
            pass


def start_log_file():
    """Tee daemon output (ANSI-stripped, timestamped) to LOG_PATH for `pr-triage logs`."""
    global _log_fh
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        if os.path.exists(LOG_PATH) and os.path.getsize(LOG_PATH) > 5 * 1024 * 1024:
            os.replace(LOG_PATH, LOG_PATH + ".1")
        _log_fh = open(LOG_PATH, "a", encoding="utf-8")
    except OSError as e:
        print(f"warning: cannot write serve log {LOG_PATH}: {e}", file=sys.stderr)


def die(msg: str, code: int = 1):
    eprint(C.red(f"pr-triage: {msg}"))
    sys.exit(code)


class ToolError(RuntimeError):
    """Raisable variant of die() so the serve daemon can report per-PR errors."""

    def __init__(self, msg: str, code: int = 1):
        super().__init__(msg)
        self.code = code


# ---------------------------------------------------------------------------
# PR reference parsing + gh
# ---------------------------------------------------------------------------

PR_URL_RE = re.compile(
    r"^https?://github\.com/(?P<owner>[^/\s]+)/(?P<repo>[^/\s]+)/pull/(?P<num>\d+)"
)
PR_SHORT_RE = re.compile(r"^(?P<owner>[^/\s]+)/(?P<repo>[^/#\s]+)#(?P<num>\d+)$")


PR_PATH_RE = re.compile(r"^/(?P<owner>[^/\s]+)/(?P<repo>[^/\s]+)/pull/(?P<num>\d+)")


def try_parse_pr_ref(ref: str, repo_flag: Optional[str] = None):
    """Return (repo 'owner/name', pr_number) or None."""
    ref = ref.strip()
    for pat in (PR_URL_RE, PR_SHORT_RE, PR_PATH_RE):
        m = pat.match(ref)
        if m:
            return f"{m.group('owner')}/{m.group('repo')}", int(m.group("num"))
    if ref.isdigit() and repo_flag:
        return repo_flag, int(ref)
    return None


def parse_pr_ref(ref: str, repo_flag: Optional[str]):
    """Return (repo 'owner/name', pr_number), or die with usage help."""
    got = try_parse_pr_ref(ref, repo_flag)
    if got:
        return got
    if ref.strip().isdigit():
        die("bare PR number needs --repo OWNER/NAME", 2)
    die(f"can't parse PR reference: {ref!r}\n"
        "  expected: https://github.com/owner/repo/pull/N | owner/repo#N | N --repo owner/repo", 2)


def canon_pr_key(ref: str) -> Optional[str]:
    """Canonical store key 'owner/repo#N' for a PR URL / short ref / path."""
    got = try_parse_pr_ref(ref)
    return f"{got[0].lower()}#{got[1]}" if got else None


def run_gh(args: list, timeout: int = 120) -> str:
    if not shutil.which("gh"):
        raise ToolError("`gh` CLI not found on PATH — install it and run `gh auth login`", 3)
    try:
        proc = subprocess.run(
            ["gh"] + args, capture_output=True, timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise ToolError(f"gh {' '.join(args[:3])}... timed out after {timeout}s", 3)
    if proc.returncode != 0:
        err = proc.stderr.decode("utf-8", errors="replace").strip()
        raise ToolError(f"gh {' '.join(args[:3])}... failed:\n{err}", 3)
    return proc.stdout.decode("utf-8", errors="replace")


def fetch_pr(repo: str, num: int):
    meta_raw = run_gh([
        "pr", "view", str(num), "--repo", repo, "--json",
        "number,title,body,url,state,isDraft,baseRefName,headRefName,"
        "additions,deletions,changedFiles,author",
    ])
    try:
        meta = json.loads(meta_raw)
    except json.JSONDecodeError:
        raise ToolError("gh returned unparseable PR metadata", 3)
    diff = run_gh(["pr", "diff", str(num), "--repo", repo], timeout=300)
    return meta, diff


def fetch_review_comments(repo: str, num: int, warnings: list) -> list:
    """Best-effort fetch of the PR's diff review comments (threads), slimmed
    for the overlay's detail view. Failures degrade to an empty list."""
    try:
        raw = run_gh(["api", f"repos/{repo}/pulls/{num}/comments?per_page=100"])
        items = json.loads(raw)
    except (ToolError, json.JSONDecodeError) as e:
        warnings.append(f"could not fetch review comments: {str(e)[:120]}")
        return []
    if not isinstance(items, list):
        return []
    if len(items) == 100:
        warnings.append("PR has 100+ review comments; only the first 100 are shown in the overlay")
    out = []
    for c in items:
        if not isinstance(c, dict):
            continue
        out.append({
            "id": c.get("id"),
            "reply_to": c.get("in_reply_to_id"),
            "path": str(c.get("path") or "")[:300],
            "line": c.get("line") if isinstance(c.get("line"), int) else c.get("original_line"),
            "user": str((c.get("user") or {}).get("login") or "")[:60],
            "body": str(c.get("body") or "")[:2000],
            "created_at": str(c.get("created_at") or "")[:25],
        })
    return out


# ---------------------------------------------------------------------------
# Unified diff parsing
# ---------------------------------------------------------------------------

DIFF_GIT_RE = re.compile(r'^diff --git (?:"?a/(?P<a>.*?)"?) (?:"?b/(?P<b>.*?)"?)$')
HUNK_HEADER_RE = re.compile(
    r"^@@ -(?P<os>\d+)(?:,(?P<oc>\d+))? \+(?P<ns>\d+)(?:,(?P<nc>\d+))? @@"
)


def unquote_git_path(p: str) -> str:
    """Decode a git C-quoted path ("caf\\303\\251.py" -> café.py); pass others through."""
    p = p.strip()
    if len(p) >= 2 and p[0] == '"' and p[-1] == '"':
        inner = p[1:-1]
        try:
            p = (inner.encode("latin1", "backslashreplace")
                 .decode("unicode_escape")
                 .encode("latin1")
                 .decode("utf-8", "replace"))
        except (UnicodeError, ValueError):
            p = inner
    return p


def _header_path(line: str, prefix: str) -> Optional[str]:
    """Extract the authoritative path from a '--- a/x' / '+++ b/x' header line."""
    val = unquote_git_path(line[4:].rstrip("\t"))
    if val == "/dev/null":
        return None
    if val.startswith(prefix):
        return val[len(prefix):]
    return val


def parse_diff(diff_text: str) -> list:
    """Parse a unified diff into FileDiff objects."""
    files: list = []
    cur: Optional[FileDiff] = None
    cur_hunk_lines: Optional[list] = None

    def flush_hunk():
        nonlocal cur_hunk_lines
        if cur is not None and cur_hunk_lines:
            header = cur_hunk_lines[0]
            m = HUNK_HEADER_RE.match(header)
            h = Hunk(
                hid="",  # assigned later
                file=cur.new_path if not cur.is_deleted else cur.old_path,
                file_status=cur.status,
                header=header,
                body="\n".join(cur_hunk_lines),
                new_start=int(m.group("ns")) if m else 0,
                new_count=int(m.group("nc") or "1") if m else 0,
                added=sum(1 for ln in cur_hunk_lines[1:] if ln.startswith("+")),
                removed=sum(1 for ln in cur_hunk_lines[1:] if ln.startswith("-")),
            )
            cur.hunks.append(h)
        cur_hunk_lines = None

    # split on \n only: str.splitlines() also breaks on \f/\v/U+2028/... which
    # occur inside legitimate source lines and would corrupt hunks
    lines = diff_text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    for raw in lines:
        line = raw.rstrip("\r")
        m = DIFF_GIT_RE.match(line)
        if m:
            flush_hunk()
            cur = FileDiff(old_path=unquote_git_path(m.group("a")),
                           new_path=unquote_git_path(m.group("b")))
            files.append(cur)
            continue
        if cur is None:
            continue
        if cur_hunk_lines is None:
            # file header zone; ---/+++/rename/copy lines carry the authoritative
            # paths (the `diff --git` line is ambiguous for odd filenames)
            if line.startswith("Binary files ") or line.startswith("GIT binary patch"):
                cur.is_binary = True
            elif line.startswith("rename from "):
                cur.is_rename = True
                cur.old_path = unquote_git_path(line[len("rename from "):])
            elif line.startswith("rename to "):
                cur.is_rename = True
                cur.new_path = unquote_git_path(line[len("rename to "):])
            elif line.startswith("copy from "):
                cur.is_copy = True
                cur.old_path = unquote_git_path(line[len("copy from "):])
            elif line.startswith("copy to "):
                cur.is_copy = True
                cur.new_path = unquote_git_path(line[len("copy to "):])
            elif line.startswith("new file mode"):
                cur.is_new = True
            elif line.startswith("deleted file mode"):
                cur.is_deleted = True
            elif line.startswith("old mode "):
                cur.old_mode = line[len("old mode "):].strip()
            elif line.startswith("new mode "):
                cur.new_mode = line[len("new mode "):].strip()
            elif line.startswith("--- "):
                p = _header_path(line, "a/")
                if p:
                    cur.old_path = p
            elif line.startswith("+++ "):
                p = _header_path(line, "b/")
                if p:
                    cur.new_path = p
            elif line.startswith("@@"):
                cur_hunk_lines = [line]
            continue
        # inside a hunk
        if line.startswith("@@"):
            flush_hunk()
            cur_hunk_lines = [line]
        elif line and line[0] in "+- \\":
            cur_hunk_lines.append(line)
        elif line == "":
            # tolerate empty context lines whose leading space was stripped
            cur_hunk_lines.append(" ")
        else:
            # anything else ends the hunk zone (e.g. next file header line)
            flush_hunk()
    flush_hunk()

    hid = 0
    for f in files:
        for h in f.hunks:
            hid += 1
            h.hid = f"H{hid}"
    return files


# ---------------------------------------------------------------------------
# Heuristic pre-scoring (noise never sent to the model)
# ---------------------------------------------------------------------------

LOCKFILE_NAMES = {
    "uv.lock", "package-lock.json", "yarn.lock", "pnpm-lock.yaml",
    "poetry.lock", "cargo.lock", "go.sum", "gemfile.lock", "composer.lock",
    "flake.lock", "packages.lock.json", "pipfile.lock", "gradle.lockfile",
}
GENERATED_PATTERNS = [
    re.compile(p, re.IGNORECASE) for p in (
        r"\.min\.(js|css)$",
        r"\.(js|css)\.map$",
        r"_pb2(_grpc)?\.pyi?$",
        r"\.pb\.go$",
        r"\.generated\.",
        r"(^|/)__snapshots__/",
        r"(^|/)vendor/",
        r"(^|/)node_modules/",
        r"(^|/)dist/",
    )
]


def classify_noise(f: FileDiff) -> Optional[tuple]:
    """Return (score, category, reason) if this file is auto-scorable noise."""
    path = (f.new_path or f.old_path or "").lower()
    base = path.rsplit("/", 1)[-1]
    if f.is_binary:
        return 2, "binary", "Binary file change; nothing to line-review."
    if base in LOCKFILE_NAMES:
        return 3, "dependency", "Lockfile regenerated from manifest; review the manifest change instead."
    for pat in GENERATED_PATTERNS:
        if pat.search(path):
            return 3, "generated", "Generated/vendored artifact; review the source that produces it."
    if (f.is_rename or f.is_copy) and not f.hunks:
        return 4, "refactor", "Pure rename/copy with no content change."
    return None


def is_whitespace_only(h: Hunk) -> bool:
    """True only for hunks whose +/- lines differ solely in TRAILING whitespace.

    Deliberately conservative: indentation moves, line joins/splits, and
    whitespace inside string literals all change behavior, so anything beyond
    trailing whitespace goes to the model. False negatives are cheap here."""
    adds, rems = [], []
    for ln in h.body.split("\n")[1:]:
        if ln.startswith("+"):
            adds.append(ln[1:].rstrip())
        elif ln.startswith("-"):
            rems.append(ln[1:].rstrip())
    return bool(adds or rems) and adds == rems


# ---------------------------------------------------------------------------
# Claude scoring
# ---------------------------------------------------------------------------

CATEGORIES = (
    "security|logic|error-handling|api-contract|data|perf|concurrency|"
    "config|dependency|build|test|docs|refactor|style|other"
)

RUBRIC = """Scoring rubric for `importance` (0-100):
  90-100  security/auth changes, data loss or corruption risk, money paths,
          core business logic, concurrency/locking, schema or API contract
          changes with broad blast radius
  70-89   behavior changes in production code paths, error-handling changes,
          non-trivial algorithms, performance-sensitive code, migrations
  40-69   moderate logic, refactors that move behavior, test logic guarding
          important behavior, build/deploy config with real impact
  15-39   boilerplate, simple wiring, docs with technical content,
          low-blast-radius config, test scaffolding
  0-14    comments/formatting only, import shuffling, renames, generated
          output, trivial constants"""

MAX_HUNK_PROMPT_CHARS = 4000
MAX_BODY_CHARS = 1500


def truncate_hunk_for_prompt(body: str) -> str:
    if len(body) <= MAX_HUNK_PROMPT_CHARS:
        return body
    head = body[:3000]
    tail = body[-800:]
    elided = len(body) - len(head) - len(tail)
    return f"{head}\n... ({elided} chars elided) ...\n{tail}"


def build_prompt(meta: dict, hunks: list) -> str:
    body = (meta.get("body") or "").strip()
    if len(body) > MAX_BODY_CHARS:
        body = body[:MAX_BODY_CHARS] + " ..."
    parts = [
        "You are a senior engineer triaging a GitHub pull request for review. "
        "For each diff hunk below, rate how much human review attention it deserves.",
        "",
        f"PR title: {meta.get('title', '')}",
        f"Branches: {meta.get('headRefName', '?')} -> {meta.get('baseRefName', '?')}",
        f"PR description:\n{body or '(none)'}",
        "",
        RUBRIC,
        "",
        "Judge each hunk in the context of the whole PR — a hunk is important if a "
        "bug or bad design there would matter in production, and unimportant if it "
        "is mechanical, cosmetic, or fully implied by another hunk.",
        "",
        "Respond with JSON only — no markdown fences, no prose — matching exactly:",
        '{"tldr":["<2-4 bullets, each <=14 words: what the PR does, why, and the main '
        'risk. Concrete fragments, no fluff, no restating the title>"],'
        '"impression":["<1-3 bullets: overall take on the WHOLE PR — what is solid, '
        'what needs attention. Concrete, no fluff>"],'
        '"approvability":<int 0-100: how close this PR is to approvable as-is — '
        "90+ approve now, 60-89 approve after small fixes or answered questions, "
        "<60 needs real work>,"
        '"approve_signal":"<one terse line: the gating item(s) blocking approval, '
        'or why it is ready — <=18 words>",'
        '"scores":[{"id":"H1","importance":<int 0-100>,'
        f'"category":"<one of: {CATEGORIES}>",'
        '"what":"<what the change does — terse fragment, or array of 2 short fragments>",'
        '"why":"<why this change is needed in this PR — terse fragment or 2-fragment array>",'
        '"tests":"<testing signal for THIS hunk, <=18 words: which test changes in this '
        "PR cover it ('covered: X_test.py updated'), 'is test code', or "
        "'no test changes touch this'>\","
        '"blast":"<blast radius if this hunk is wrong, <=15 words: who/what breaks and '
        "how wide — e.g. 'all jobs importing this settings module', 'CI lint only', "
        "'single DAG'>\","
        '"verdict":"<overall impression, max 25 words: what this change gets right AND '
        "the one specific thing to fix or double-check if any. Never vague flags like "
        "'review carefully' — name the actual issue or say plainly why it is fine. "
        'Not pedantic>"}, ...]}',
        "Include exactly one entry for every hunk id listed below.",
        "",
        "=== HUNKS ===",
    ]
    for h in hunks:
        parts.append("")
        parts.append(f"[{h.hid}] file: {h.file} ({h.file_status})")
        parts.append(truncate_hunk_for_prompt(h.body))
    return "\n".join(parts)


def batch_hunks(hunks: list, max_chars: int) -> list:
    """Group hunks into batches whose prompt bodies stay under max_chars."""
    batches, cur, cur_size = [], [], 0
    for h in hunks:
        size = min(len(h.body), MAX_HUNK_PROMPT_CHARS) + 100
        if cur and cur_size + size > max_chars:
            batches.append(cur)
            cur, cur_size = [], 0
        cur.append(h)
        cur_size += size
    if cur:
        batches.append(cur)
    return batches


def clean_claude_env() -> dict:
    """Inherit the environment but drop nested-Claude-session markers that
    would confuse a child `claude` process when pr-triage itself is run from
    inside a Claude Code session. Only the session markers are removed — auth
    and backend selection (CLAUDE_CODE_OAUTH_TOKEN, CLAUDE_CODE_USE_BEDROCK,
    ANTHROPIC_*) pass through untouched."""
    env = dict(os.environ)
    for k in ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_SSE_PORT"):
        env.pop(k, None)
    return env


def extract_json(text: str) -> dict:
    """Pull a JSON object out of model output, tolerating fences and prose.

    Uses raw_decode (string/escape-aware — braces inside string values are
    fine) at each '{' candidate; prefers an object carrying a 'scores' key."""
    text = text.strip()
    fence = re.search(r"```(?:json)?\s*(\{.*?\})\s*```", text, re.DOTALL)
    if fence:
        text = fence.group(1)
    dec = json.JSONDecoder()
    fallback = None
    idx = text.find("{")
    while idx != -1:
        try:
            obj, _end = dec.raw_decode(text, idx)
            if isinstance(obj, dict):
                if "scores" in obj:
                    return obj
                if fallback is None:
                    fallback = obj
        except (json.JSONDecodeError, RecursionError):
            pass
        idx = text.find("{", idx + 1)
    if fallback is not None:
        return fallback
    raise ValueError("no JSON object in model output")


class ClaudeError(RuntimeError):
    pass


def run_claude_json(prompt: str, opts, workdir: str) -> tuple:
    """Run one claude call expected to answer with a JSON object.
    Returns (payload_dict, cost_usd). Raises ClaudeError/ValueError."""
    text, cost = run_claude_text(prompt, opts, workdir)
    return extract_json(text), cost


def call_claude(prompt: str, opts, workdir: str) -> tuple:
    """Run one scoring call. Returns (scores_list, tldr, cost_usd)."""
    text, cost = run_claude_text(prompt, opts, workdir)
    payload = extract_json(text)
    scores = payload.get("scores")
    if not isinstance(scores, list):
        raise ValueError("model JSON missing 'scores' list")
    try:
        approvability = max(0, min(100, int(payload.get("approvability"))))
    except (TypeError, ValueError):
        approvability = None
    prmeta = {
        "tldr": norm_note(payload.get("tldr"), cap=900, items=6),
        "impression": norm_note(payload.get("impression"), cap=900, items=4),
        "approvability": approvability,
        "approve_signal": norm_note(payload.get("approve_signal"), cap=300, items=2),
    }
    return scores, prmeta, cost


def norm_note(v, cap: int = 300, items: int = 4) -> str:
    """Normalize a model note that may be a string or a list of bullet
    fragments into a newline-joined string (renderers split on newlines)."""
    if isinstance(v, list):
        v = "\n".join(str(x).strip()[:200] for x in v[:items] if str(x).strip())
    return v.strip()[:cap] if isinstance(v, str) else ""


def run_claude_text(prompt: str, opts, workdir: str) -> tuple:
    cmd = [
        opts.claude_bin, "-p",
        "--output-format", "json",
        "--tools", "",
        "--safe-mode",
        "--no-session-persistence",
    ]
    if opts.model:
        cmd += ["--model", opts.model]
    for extra in opts.claude_arg or []:
        cmd += shlex.split(extra)
    try:
        proc = subprocess.run(
            cmd, input=prompt.encode("utf-8"), capture_output=True,
            timeout=opts.timeout, cwd=workdir, env=clean_claude_env(),
        )
    except subprocess.TimeoutExpired:
        raise ClaudeError(f"claude call timed out after {opts.timeout}s "
                          "(local models can be slow — try --timeout 1200 or a smaller --batch-chars)")
    except FileNotFoundError:
        raise ClaudeError(f"claude binary not found: {opts.claude_bin}")
    except OSError as e:
        raise ClaudeError(f"cannot execute claude binary {opts.claude_bin}: {e}")
    stdout = proc.stdout.decode("utf-8", errors="replace")
    stderr = proc.stderr.decode("utf-8", errors="replace")
    if proc.returncode != 0 and not stdout.strip():
        raise ClaudeError(f"claude exited {proc.returncode}: {stderr.strip()[:500]}")
    try:
        envelope = json.loads(stdout)
    except json.JSONDecodeError:
        raise ClaudeError(f"claude did not return a JSON envelope: {stdout.strip()[:300]}")
    if envelope.get("is_error"):
        raise ClaudeError(f"claude reported an error: {str(envelope.get('result'))[:300]}")
    result_text = envelope.get("result") or ""
    if isinstance(result_text, dict):
        result_text = json.dumps(result_text)
    return str(result_text), float(envelope.get("total_cost_usd") or 0.0)


def score_batch(batch: list, meta: dict, opts, workdir: str) -> tuple:
    """Score one batch, retrying once on malformed output. Returns (scores, cost)."""
    prompt = build_prompt(meta, batch)
    attempts, last_err = 0, None
    total_cost = 0.0
    while attempts < 2:
        attempts += 1
        try:
            scores, prmeta, cost = call_claude(prompt, opts, workdir)
            return scores, prmeta, total_cost + cost
        except ClaudeError:
            raise
        except (ValueError, json.JSONDecodeError) as e:
            last_err = e
            prompt = prompt + (
                "\n\nIMPORTANT: your previous reply was not valid JSON. "
                "Reply with ONLY the JSON object described above."
            )
    raise ClaudeError(f"model output unparseable after retry: {last_err}")


def apply_scores(hunks_by_id: dict, scores: list, warnings: list):
    for entry in scores:
        if not isinstance(entry, dict):
            continue
        hid = str(entry.get("id", "")).strip()
        h = hunks_by_id.get(hid)
        if h is None:
            warnings.append(f"model returned unknown hunk id {hid!r}; ignored")
            continue
        try:
            imp = int(entry.get("importance"))
        except (TypeError, ValueError):
            warnings.append(f"{hid}: non-numeric importance; left unscored")
            continue
        h.importance = max(0, min(100, imp))
        h.category = str(entry.get("category", "other"))[:32] or "other"
        h.what = norm_note(entry.get("what"))
        h.why = norm_note(entry.get("why"))
        h.tests = norm_note(entry.get("tests"))
        h.blast = norm_note(entry.get("blast"))
        h.verdict = norm_note(entry.get("verdict"))
        # compact one-liner for tables/badges; older models may still send "reason"
        h.reason = (h.verdict.split("\n")[0] if h.verdict else "") \
            or norm_note(entry.get("reason")) or h.what.split("\n")[0]


def prepare_triage(repo: str, num: int, opts):
    """Fetch and classify a PR. Returns (meta, files, all_hunks, to_score, warnings).
    Raises ToolError on gh failures."""
    eprint(C.dim(f"fetching {repo}#{num} via gh ..."))
    meta, diff_text = fetch_pr(repo, num)
    files = parse_diff(diff_text)

    warnings: list = []
    # review-comment threads ride along on meta for the overlay's detail view
    meta["_triage_comments"] = fetch_review_comments(repo, num, warnings)
    all_hunks: list = []
    to_score: list = []
    for f in files:
        noise = None if opts.no_heuristics else classify_noise(f)
        if not f.hunks:
            # binary / rename / copy / mode-only / empty-file diffs have no text
            # hunks; synthesize one entry so the file never vanishes from output.
            # (Must run after classify_noise: its pure-rename rule checks hunks.)
            if f.old_mode and f.new_mode:
                detail = f"mode change {f.old_mode} -> {f.new_mode}"
            else:
                detail = f"{f.status} with no content change"
            f.hunks.append(Hunk(
                hid="", file=f.display_path, file_status=f.status,
                header="", body=f"(no text diff: {detail} — {f.display_path})",
            ))
        if noise is not None:
            score, cat, reason = noise
            for h in f.hunks:
                h.importance, h.category, h.reason, h.heuristic = score, cat, reason, True
                all_hunks.append(h)
            continue
        for h in f.hunks:
            if not opts.no_heuristics and is_whitespace_only(h):
                h.importance, h.category, h.heuristic = 5, "style", True
                h.reason = "Trailing-whitespace-only change."
                all_hunks.append(h)
                continue
            all_hunks.append(h)
            to_score.append(h)

    # re-assign ids for synthesized hunks
    for i, h in enumerate(all_hunks, 1):
        if not h.hid:
            h.hid = f"H{i}n"
    return meta, files, all_hunks, to_score, warnings


def score_hunks(to_score: list, meta: dict, opts, warnings: list) -> float:
    """Score hunks with claude, mutating them in place. Returns API cost.
    Raises ClaudeError on a fatal model/subprocess failure."""
    if not to_score:
        eprint(C.dim("all hunks classified heuristically; skipping claude"))
        return 0.0
    batches = batch_hunks(to_score, opts.batch_chars)
    eprint(C.dim(f"scoring {len(to_score)} hunks in {len(batches)} claude call(s) "
                 f"(model: {opts.model or 'claude default'}) ..."))
    total_cost = 0.0
    workdir = tempfile.mkdtemp(prefix="pr-triage-")
    fatal: Optional[ClaudeError] = None
    tldrs: dict = {}  # batch index -> pr-level meta; keep the earliest batch's wording
    try:
        workers = max(1, min(opts.parallel, len(batches)))
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as ex:
            futs = {ex.submit(score_batch, b, meta, opts, workdir): i
                    for i, b in enumerate(batches)}
            try:
                for fut in concurrent.futures.as_completed(futs):
                    try:
                        scores, prmeta, cost = fut.result()
                    except ClaudeError as e:
                        fatal = e
                        ex.shutdown(wait=False, cancel_futures=True)
                        break
                    total_cost += cost
                    if prmeta.get("tldr") or prmeta.get("impression"):
                        tldrs[futs[fut]] = prmeta
                    # score against the batch's own hunks only, so a model
                    # echoing ids from the prompt example (or another batch)
                    # can't overwrite unrelated hunks
                    apply_scores({h.hid: h for h in batches[futs[fut]]}, scores, warnings)
            except KeyboardInterrupt:
                ex.shutdown(wait=False, cancel_futures=True)
                raise
    finally:
        shutil.rmtree(workdir, ignore_errors=True)
    if tldrs:
        best = tldrs[min(tldrs)]
        meta["_triage_tldr"] = best.get("tldr") or ""
        meta["_triage_impression"] = best.get("impression") or ""
        meta["_triage_approvability"] = best.get("approvability")
        meta["_triage_approve_signal"] = best.get("approve_signal") or ""
    if fatal is not None:
        raise fatal
    missing = [h.hid for h in to_score if h.importance is None]
    if missing:
        warnings.append(f"{len(missing)} hunk(s) not scored by the model: {', '.join(missing[:8])}")
    return total_cost


