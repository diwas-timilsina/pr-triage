def build_index_html(entries: list) -> str:
    rows = []
    for e in entries:
        st = e["status"]
        live = ' data-live="1"' if st in ("queued", "running") else ""
        links = ""
        if st == "done":
            saved = f'<span class="st">{html_mod.escape(e.get("saved") or "")}</span>' if e.get("saved") else ""
            links = (f'<a href="/report?pr={urllib.parse.quote(e["key"])}">report</a> '
                     f'<a href="{html_mod.escape(e["url"])}/files" target="_blank" rel="noopener">github</a>'
                     f'<span class="st">{e["hunks"]} hunks</span>{saved}')
        err = f'<span class="title">{html_mod.escape(e.get("error") or "")}</span>' if st == "error" else ""
        rows.append(
            f'<div class="row"{live}><span class="st {st}">{st}</span>'
            f'<span class="key">{html_mod.escape(e["key"])}</span>'
            f'<span class="title">{html_mod.escape(e.get("title") or "")}</span>{err}{links}</div>'
        )
    if not rows:
        rows.append('<div class="row"><span class="title">nothing triaged yet — add a PR above</span></div>')
    return INDEX_TEMPLATE.replace("__ROWS__", "\n".join(rows))


def daemon_serve(port: int, opts, seeds: list):
    """Run the triage server. seeds: list of (key, payload, html) already scored."""
    store: dict = {}      # key -> {status, title, url, hunks, payload, html, error}
    lock = threading.Lock()
    jobs: queue.Queue = queue.Queue(maxsize=32)
    token = secrets.token_hex(16)
    MAX_STORE = 50

    def evict_locked():
        # caller holds `lock`: drop oldest finished entries beyond the cap
        while len(store) > MAX_STORE:
            victim = next((k for k, v in store.items()
                           if v["status"] in ("done", "error")), None)
            if victim is None:
                break
            del store[victim]
            delete_persisted(victim)

    for key, payload, html_doc in seeds:
        store[key] = {"status": "done", "title": payload["pr"].get("title") or "",
                      "url": payload["pr"].get("url") or "", "hunks": len(payload["hunks"]),
                      "payload": payload, "html": html_doc, "error": "",
                      "saved": time.strftime("%Y-%m-%d %H:%M")}
        persist_entry(key, store[key])

    restored = 0
    for key, entry in load_persisted():
        if key not in store:
            store[key] = entry
            restored += 1
    evict_locked()
    if restored:
        eprint(C.dim(f"restored {restored} saved triage(s) from {STORE_DIR}"))

    def worker():
        while True:
            key, repo, num = jobs.get()
            try:
                meta, files, all_hunks, to_score, warnings = prepare_triage(repo, num, opts)
                with lock:
                    store[key]["status"] = "running"
                    store[key]["title"] = meta.get("title") or ""
                    store[key]["url"] = meta.get("url") or ""
                cost = score_hunks(to_score, meta, opts, warnings)
                payload = build_report_doc(meta, all_hunks, opts, cost)
                html_doc = render_html(meta, all_hunks, opts)
                with lock:
                    store[key].update(status="done", payload=payload, html=html_doc,
                                      hunks=len(payload["hunks"]), error="",
                                      saved=time.strftime("%Y-%m-%d %H:%M"))
                    persist_entry(key, store[key])
                eprint(C.bold_green(f"triaged {key}: {len(payload['hunks'])} hunks, ${cost:.4f}"))
                auto_review(key)
            except Exception as e:  # daemon must survive any per-PR failure
                with lock:
                    store[key].update(status="error", error=str(e)[:500])
                eprint(C.red(f"triage of {key} failed: {str(e)[:200]}"))

    review_sem = threading.Semaphore(2)

    def review_job(key: str, hid: str):
        with review_sem:
            with lock:
                entry = store.get(key)
                if not entry or entry.get("status") != "done":
                    return
                hunk = next((h for h in entry["payload"]["hunks"] if h.get("id") == hid), None)
                if hunk is None:
                    entry.setdefault("reviews", {})[hid] = {"status": "error", "error": "unknown hunk"}
                    return
                file_threads = [c for c in (entry["payload"].get("comments") or [])
                                if c.get("path") == hunk.get("file")]
                prompt = build_review_prompt(entry["payload"], hunk, file_threads)
            workdir = tempfile.mkdtemp(prefix="pr-triage-review-")
            try:
                payload, cost = run_claude_json(prompt, opts, workdir)
                result = slim_review(payload)
                result["status"] = "done"
                with lock:
                    entry = store.get(key)
                    if entry:
                        entry.setdefault("reviews", {})[hid] = result
                        persist_entry(key, entry)
                eprint(C.bold_green(
                    f"deep review {key} {hid}: {len(result['comments'])} comment(s), "
                    f"{len(result['replies'])} reply draft(s), ${cost:.4f}"))
            except Exception as e:  # daemon must survive any per-review failure
                with lock:
                    entry = store.get(key)
                    if entry:
                        entry.setdefault("reviews", {})[hid] = {
                            "status": "error", "error": str(e)[:300]}
                eprint(C.red(f"deep review of {key} {hid} failed: {str(e)[:200]}"))
            finally:
                shutil.rmtree(workdir, ignore_errors=True)

    def auto_review(key: str):
        """Pre-generate deep reviews for the top-scoring hunks right after a
        triage lands, so 'Review this diff' is an instant read for them."""
        if getattr(opts, "auto_review", 0) <= 0:
            return
        with lock:
            entry = store.get(key)
            if not entry or entry["status"] != "done":
                return
            hunks = [h for h in entry["payload"]["hunks"]
                     if not h.get("heuristic") and h.get("id")
                     and isinstance(h.get("importance"), int)
                     and h["importance"] >= opts.auto_review_min]
            hunks.sort(key=lambda x: -x["importance"])
            reviews = entry.setdefault("reviews", {})
            todo = []
            for h in hunks[:opts.auto_review]:
                cur = reviews.get(h["id"])
                if cur and cur.get("status") in ("queued", "running", "done"):
                    continue
                reviews[h["id"]] = {"status": "running"}
                todo.append(h["id"])
        for hid in todo:
            threading.Thread(target=review_job, args=(key, hid), daemon=True).start()
        if todo:
            eprint(C.dim(f"auto-reviewing {len(todo)} hunk(s) ≥{opts.auto_review_min}% on {key}"))

    def entry_for(pr_param: str) -> Optional[dict]:
        key = canon_pr_key(pr_param) if pr_param else None
        with lock:
            if key and key in store:
                return dict(store[key], key=key)
            if not pr_param:
                done = [(k, v) for k, v in store.items() if v["status"] == "done"]
                if len(done) == 1:
                    return dict(done[0][1], key=done[0][0])
        return None

    class Handler(http.server.BaseHTTPRequestHandler):
        # Payloads are full PR diffs (possibly private source): CORS is granted
        # ONLY to github.com; everything else can't read responses cross-origin.
        # POST /triage additionally requires the X-PR-Triage header, so a random
        # website can never trigger a triage (custom header -> CORS preflight,
        # which only github.com passes). POST /publish requires the daemon token
        # from the 0600 state file, which no web page can read.
        def _cors(self):
            origin = self.headers.get("Origin", "")
            if origin == "https://github.com":
                self.send_header("Access-Control-Allow-Origin", origin)
                self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
                self.send_header("Access-Control-Allow-Headers", "Content-Type, X-PR-Triage")
                self.send_header("Access-Control-Allow-Private-Network", "true")
            self.send_header("Vary", "Origin")

        def _host_ok(self) -> bool:
            host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
            return host in ("127.0.0.1", "localhost", "")

        def _send(self, code: int, ctype: str, body: bytes):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self._cors()
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _json(self, code: int, obj: dict):
            self._send(code, "application/json; charset=utf-8",
                       json.dumps(obj).encode("utf-8"))

        def _body(self, cap: int) -> Optional[dict]:
            try:
                n = int(self.headers.get("Content-Length") or 0)
                if n <= 0 or n > cap:
                    return None
                parsed = json.loads(self.rfile.read(n).decode("utf-8", errors="replace"))
                return parsed if isinstance(parsed, dict) else None
            except (ValueError, OSError):
                return None

        def _query(self) -> dict:
            return dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(self.path).query))

        def do_OPTIONS(self):
            if not self._host_ok():
                self.send_response(403)
                self.end_headers()
                return
            self.send_response(204)
            self._cors()
            self.end_headers()

        def do_GET(self):
            if not self._host_ok():
                self._send(403, "text/plain; charset=utf-8", b"forbidden")
                return
            path = urllib.parse.urlsplit(self.path).path.rstrip("/") or "/"
            if path == "/health":
                self._json(200, {"app": "pr-triage", "port": port})
            elif path == "/triage.json":
                entry = entry_for(self._query().get("pr", ""))
                if entry and entry["status"] == "done":
                    # deep-review results ride along so a reloaded page can
                    # hydrate finished/in-flight reviews instead of losing them
                    body = dict(entry["payload"])
                    with lock:
                        raw = (store.get(entry["key"]) or {}).get("reviews") or {}
                        body["reviews"] = {k: dict(v) for k, v in raw.items()
                                           if isinstance(v, dict)
                                           and v.get("status") in ("done", "running")}
                    self._json(200, body)
                elif entry:
                    self._json(404, {"status": entry["status"], "error": entry.get("error") or ""})
                else:
                    self._json(404, {"status": "absent"})
            elif path == "/status":
                entry = entry_for(self._query().get("pr", ""))
                if entry:
                    self._json(200, {"status": entry["status"], "error": entry.get("error") or ""})
                else:
                    self._json(404, {"status": "absent"})
            elif path == "/review":
                q = self._query()
                entry = entry_for(q.get("pr", ""))
                hid = q.get("id", "")
                if not entry or entry["status"] != "done":
                    self._json(404, {"status": "absent"})
                    return
                with lock:
                    stored = store.get(entry["key"], {})
                    r = (stored.get("reviews") or {}).get(hid)
                self._json(200, r) if r else self._json(404, {"status": "absent"})
            elif path == "/report":
                entry = entry_for(self._query().get("pr", ""))
                if entry and entry["status"] == "done":
                    self._send(200, "text/html; charset=utf-8", entry["html"].encode("utf-8"))
                else:
                    self._send(404, "text/plain; charset=utf-8", b"no report for that PR")
            elif path == "/":
                with lock:
                    entries = [dict(key=k, status=v["status"], title=v.get("title", ""),
                                    url=v.get("url", ""), hunks=v.get("hunks", 0),
                                    error=v.get("error", ""), saved=v.get("saved", ""))
                               for k, v in store.items()]
                self._send(200, "text/html; charset=utf-8",
                           build_index_html(entries).encode("utf-8"))
            else:
                self._send(404, "text/plain; charset=utf-8", b"not found")

        def do_POST(self):
            if not self._host_ok():
                self._send(403, "text/plain; charset=utf-8", b"forbidden")
                return
            path = urllib.parse.urlsplit(self.path).path.rstrip("/")
            if path == "/triage":
                if self.headers.get("X-PR-Triage") != "1":
                    self._json(403, {"error": "missing X-PR-Triage header"})
                    return
                body = self._body(4096)
                ref = (body or {}).get("pr", "")
                got = try_parse_pr_ref(str(ref))
                if not got:
                    self._json(400, {"error": f"can't parse PR reference: {str(ref)[:100]!r}"})
                    return
                repo, num = got
                key = f"{repo.lower()}#{num}"
                with lock:
                    cur = store.get(key)
                    if cur and cur["status"] in ("queued", "running"):
                        self._json(202, {"status": cur["status"]})
                        return
                    if cur and cur["status"] == "done" and not (body or {}).get("force"):
                        self._json(200, {"status": "done"})
                        return
                    store[key] = {"status": "queued", "title": "", "url": "",
                                  "hunks": 0, "payload": None, "html": "", "error": ""}
                    evict_locked()
                try:
                    jobs.put_nowait((key, repo, num))
                except queue.Full:
                    with lock:
                        store.pop(key, None)
                    self._json(503, {"error": "triage queue full — retry later"})
                    return
                self._json(202, {"status": "queued"})
            elif path == "/review":
                if self.headers.get("X-PR-Triage") != "1":
                    self._json(403, {"error": "missing X-PR-Triage header"})
                    return
                body = self._body(4096)
                key = canon_pr_key(str((body or {}).get("pr", "")))
                hid = str((body or {}).get("id", ""))
                if not key or not re.match(r"^H\d+n?$", hid):
                    self._json(400, {"error": "bad review request"})
                    return
                with lock:
                    entry = store.get(key)
                    if not entry or entry["status"] != "done":
                        self._json(404, {"status": "absent"})
                        return
                    cur = (entry.get("reviews") or {}).get(hid)
                    if cur and cur.get("status") in ("queued", "running", "done"):
                        self._json(202 if cur["status"] != "done" else 200,
                                   {"status": cur["status"]})
                        return
                    entry.setdefault("reviews", {})[hid] = {"status": "running"}
                threading.Thread(target=review_job, args=(key, hid), daemon=True).start()
                self._json(202, {"status": "running"})
            elif path == "/chat":
                if self.headers.get("X-PR-Triage") != "1":
                    self._json(403, {"error": "missing X-PR-Triage header"})
                    return
                body = self._body(256 * 1024)
                key = canon_pr_key(str((body or {}).get("pr", "")))
                msgs = (body or {}).get("messages")
                if not key or not isinstance(msgs, list) or not msgs:
                    self._json(400, {"error": "bad chat request"})
                    return
                msgs = [m for m in msgs if isinstance(m, dict)
                        and m.get("role") in ("user", "assistant")
                        and isinstance(m.get("text"), str)][-20:]
                with lock:
                    entry = store.get(key)
                    if not entry or entry["status"] != "done":
                        self._json(404, {"status": "absent"})
                        return
                    payload = entry["payload"]
                    hid = str((body or {}).get("id") or "")
                    hunk, fthreads = None, []
                    if hid:
                        hunk = next((h for h in payload["hunks"] if h.get("id") == hid), None)
                        if hunk is None:
                            self._json(400, {"error": "unknown hunk"})
                            return
                        fthreads = [c for c in (payload.get("comments") or [])
                                    if c.get("path") == hunk.get("file")]
                    prompt = build_chat_prompt(payload, hunk, fthreads, msgs)
                with review_sem:
                    workdir = tempfile.mkdtemp(prefix="pr-triage-chat-")
                    try:
                        reply, cost = run_claude_text(prompt, opts, workdir)
                        eprint(C.dim(f"chat {key}{' ' + hid if hid else ''}: ${cost:.4f}"))
                        self._json(200, {"reply": reply.strip()[:8000]})
                    except Exception as e:  # surface chat errors, keep daemon alive
                        self._json(502, {"error": str(e)[:300]})
                    finally:
                        shutil.rmtree(workdir, ignore_errors=True)
            elif path == "/reword":
                if self.headers.get("X-PR-Triage") != "1":
                    self._json(403, {"error": "missing X-PR-Triage header"})
                    return
                body = self._body(16 * 1024)
                key = canon_pr_key(str((body or {}).get("pr", "")))
                text = str((body or {}).get("text", "")).strip()
                if not key or not (1 <= len(text) <= 4000):
                    self._json(400, {"error": "bad reword request"})
                    return
                prompt = (
                    "Reword the following code-review comment so it reads like a "
                    "thoughtful human reviewer wrote it: plain language, simpler terms, "
                    "direct and collegial. Keep every technical point and any line or "
                    "identifier references exactly. No filler, no bullet lists, at most "
                    "3 short sentences. Reply with ONLY the reworded comment text.\n\n"
                    "=== COMMENT ===\n" + text)
                with review_sem:
                    workdir = tempfile.mkdtemp(prefix="pr-triage-reword-")
                    try:
                        reworded, cost = run_claude_text(prompt, opts, workdir)
                        eprint(C.dim(f"reword on {key}: ${cost:.4f}"))
                        self._json(200, {"reword": reworded.strip()[:4000]})
                    except Exception as e:  # surface, keep daemon alive
                        self._json(502, {"error": str(e)[:300]})
                    finally:
                        shutil.rmtree(workdir, ignore_errors=True)
            elif path == "/post_comment":
                if self.headers.get("X-PR-Triage") != "1":
                    self._json(403, {"error": "missing X-PR-Triage header"})
                    return
                body = self._body(80 * 1024)
                key = canon_pr_key(str((body or {}).get("pr", "")))
                hid = str((body or {}).get("id", ""))
                text = str((body or {}).get("body", "")).strip()
                try:
                    line = int((body or {}).get("line"))
                except (TypeError, ValueError):
                    line = 0
                if not key or not re.match(r"^H\d+n?$", hid) or not (1 <= line <= 1000000) \
                        or not (1 <= len(text) <= 60000):
                    self._json(400, {"error": "bad comment request"})
                    return
                with lock:
                    entry = store.get(key)
                    hunk = None
                    if entry and entry["status"] == "done":
                        hunk = next((h for h in entry["payload"]["hunks"]
                                     if h.get("id") == hid), None)
                if hunk is None:
                    self._json(404, {"status": "absent"})
                    return
                fpath = str(hunk.get("file") or "").split(" -> ")[-1]
                repo, num = key.rsplit("#", 1)
                try:
                    sha = json.loads(run_gh(
                        ["pr", "view", num, "--repo", repo, "--json", "headRefOid"]))["headRefOid"]
                    out = run_gh(["api", f"repos/{repo}/pulls/{num}/comments",
                                  "-f", f"body={text}", "-f", f"commit_id={sha}",
                                  "-f", f"path={fpath}", "-F", f"line={line}",
                                  "-f", "side=RIGHT"])
                    created = json.loads(out) or {}
                    eprint(C.bold_green(f"posted review comment on {key} {fpath}:{line}"))
                    self._json(200, {"ok": True, "url": str(created.get("html_url") or ""),
                                     "comment_id": created.get("id")})
                except (ToolError, json.JSONDecodeError, KeyError, TypeError) as e:
                    self._json(502, {"error": str(e)[:400]})
            elif path == "/post_reply":
                if self.headers.get("X-PR-Triage") != "1":
                    self._json(403, {"error": "missing X-PR-Triage header"})
                    return
                body = self._body(80 * 1024)
                key = canon_pr_key(str((body or {}).get("pr", "")))
                text = str((body or {}).get("body", "")).strip()
                try:
                    cid = int((body or {}).get("reply_to_id"))
                except (TypeError, ValueError):
                    cid = 0
                if not key or cid <= 0 or not (1 <= len(text) <= 60000):
                    self._json(400, {"error": "bad reply request"})
                    return
                repo, num = key.rsplit("#", 1)
                try:
                    out = run_gh(["api", f"repos/{repo}/pulls/{num}/comments/{cid}/replies",
                                  "-f", f"body={text}"])
                    created = json.loads(out) or {}
                    eprint(C.bold_green(f"posted reply to comment {cid} on {key}"))
                    self._json(200, {"ok": True, "url": str(created.get("html_url") or ""),
                                     "comment_id": created.get("id")})
                except (ToolError, json.JSONDecodeError, TypeError) as e:
                    self._json(502, {"error": str(e)[:400]})
            elif path == "/delete_comment":
                if self.headers.get("X-PR-Triage") != "1":
                    self._json(403, {"error": "missing X-PR-Triage header"})
                    return
                body = self._body(4096)
                key = canon_pr_key(str((body or {}).get("pr", "")))
                try:
                    cid = int((body or {}).get("comment_id"))
                except (TypeError, ValueError):
                    cid = 0
                if not key or cid <= 0:
                    self._json(400, {"error": "bad delete request"})
                    return
                repo, _num = key.rsplit("#", 1)
                try:
                    run_gh(["api", "-X", "DELETE", f"repos/{repo}/pulls/comments/{cid}"])
                except ToolError as e:
                    self._json(502, {"error": str(e)[:400]})
                    return
                # drop it (and replies hanging off it) from the stored threads too
                with lock:
                    entry = store.get(key)
                    if entry and entry.get("payload"):
                        cs = entry["payload"].get("comments") or []
                        entry["payload"]["comments"] = [
                            c for c in cs
                            if c.get("id") != cid and c.get("reply_to") != cid]
                        persist_entry(key, entry)
                eprint(C.bold_green(f"deleted review comment {cid} on {key}"))
                self._json(200, {"ok": True})
            elif path == "/dismiss_suggestion":
                if self.headers.get("X-PR-Triage") != "1":
                    self._json(403, {"error": "missing X-PR-Triage header"})
                    return
                body = self._body(4096)
                key = canon_pr_key(str((body or {}).get("pr", "")))
                hid = str((body or {}).get("id", ""))
                kind = str((body or {}).get("kind", "comment"))
                try:
                    idx = int((body or {}).get("index"))
                except (TypeError, ValueError):
                    idx = -1
                if not key or not re.match(r"^H\d+n?$", hid) \
                        or kind not in ("comment", "reply") or idx < 0:
                    self._json(400, {"error": "bad dismiss request"})
                    return
                with lock:
                    entry = store.get(key)
                    review = (entry or {}).get("reviews", {}).get(hid) if entry else None
                    arr = (review or {}).get("comments" if kind == "comment" else "replies")
                    if not isinstance(arr, list) or idx >= len(arr):
                        self._json(404, {"error": "no such suggestion"})
                        return
                    del arr[idx]
                    persist_entry(key, entry)
                self._json(200, {"ok": True})
            elif path == "/purge":
                if self.headers.get("X-PR-Triage-Token") != token:
                    self._json(403, {"error": "bad token"})
                    return
                body = self._body(4096)
                pkey = (body or {}).get("key")
                with lock:
                    if pkey:
                        pkey = canon_pr_key(str(pkey))
                        n = 1 if pkey and store.pop(pkey, None) is not None else 0
                        if n:
                            delete_persisted(pkey)
                    else:
                        n = len(store)
                        for k in list(store):
                            delete_persisted(k)
                        store.clear()
                eprint(C.dim(f"serve: purged {n} stored triage(s)"))
                self._json(200, {"ok": True, "purged": n})
            elif path == "/publish":
                if self.headers.get("X-PR-Triage-Token") != token:
                    self._json(403, {"error": "bad token"})
                    return
                body = self._body(64 * 1024 * 1024)
                key = canon_pr_key(str((body or {}).get("key", "")))
                payload, html_doc = (body or {}).get("payload"), (body or {}).get("html")
                if not key or not isinstance(payload, dict) or not isinstance(html_doc, str):
                    self._json(400, {"error": "bad publish body"})
                    return
                with lock:
                    store[key] = {"status": "done",
                                  "title": (payload.get("pr") or {}).get("title") or "",
                                  "url": (payload.get("pr") or {}).get("url") or "",
                                  "hunks": len(payload.get("hunks") or []),
                                  "payload": payload, "html": html_doc, "error": "",
                                  "saved": time.strftime("%Y-%m-%d %H:%M")}
                    persist_entry(key, store[key])
                    evict_locked()
                eprint(C.dim(f"serve: accepted published triage for {key}"))
                auto_review(key)
                self._json(200, {"status": "done"})
            else:
                self._send(404, "text/plain; charset=utf-8", b"not found")

        def log_message(self, fmt, *args):
            if opts.verbose:
                eprint(C.dim(f"serve: {fmt % args}"))

    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError as e:
        raise ToolError(f"cannot serve on 127.0.0.1:{port}: {e}", 1)
    start_log_file()
    threading.Thread(target=worker, daemon=True).start()
    prior = read_serve_state()
    if prior and prior.get("port") not in (None, port):
        eprint(C.yellow(f"note: replacing serve state previously owned by port {prior.get('port')} — "
                        "`--serve` publishes now target this server"))
    write_serve_state({"port": port, "token": token, "pid": os.getpid()})
    def _on_term(*_args):
        raise KeyboardInterrupt

    try:
        import signal
        signal.signal(signal.SIGTERM, _on_term)
    except (ValueError, OSError):
        pass  # not the main thread / unsupported platform: stale state file is harmless
    eprint()
    eprint(C.bold(f"pr-triage server on http://127.0.0.1:{port}"))
    eprint(f"  · dashboard:     http://127.0.0.1:{port}/")
    eprint(f"  · overlay json:  http://127.0.0.1:{port}/triage.json?pr=<owner/repo%23N>")
    eprint(C.dim("  add PRs from the dashboard, the GitHub overlay button, or `pr-triage <pr> --serve`"))
    eprint(C.dim("  Ctrl-C to stop"))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        eprint("\nserve stopped")
    finally:
        server.server_close()
        try:
            st = read_serve_state()
            # only remove the state file if this daemon still owns it
            if st and st.get("pid") == os.getpid() and st.get("port") == port:
                os.remove(SERVE_STATE_PATH)
        except OSError:
            pass


def publish_to_daemon(port: int, key: str, payload: dict, html_doc: str) -> bool:
    """Push a finished triage into an already-running daemon. True on success."""
    state = read_serve_state()
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=3) as resp:
            if json.load(resp).get("app") != "pr-triage":
                return False
    except (OSError, ValueError):
        return False
    if not state or state.get("port") != port or not state.get("token"):
        raise ToolError(f"a pr-triage server is on port {port} but its state file is missing/stale "
                        f"({SERVE_STATE_PATH}) — restart it with `pr-triage serve`", 1)
    req = urllib.request.Request(
        f"http://127.0.0.1:{port}/publish", method="POST",
        data=json.dumps({"key": key, "payload": payload, "html": html_doc}).encode("utf-8"),
        headers={"Content-Type": "application/json", "X-PR-Triage-Token": state["token"]},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status == 200
    except OSError as e:
        raise ToolError(f"publishing to the running pr-triage server failed: {e}", 1)


def serve_or_publish(port: int, key: str, payload: dict, html_doc: str, opts):
    """Start the daemon seeded with this result, or publish into a running one."""
    try:
        daemon_serve(port, opts, [(key, payload, html_doc)])
    except ToolError:
        try:
            published = publish_to_daemon(port, key, payload, html_doc)
        except ToolError as e:
            die(str(e), e.code)
        if published:
            eprint(C.bold_green(
                f"published {key} to the running pr-triage server (http://127.0.0.1:{port}/)"))
        else:
            die(f"port {port} is in use by something that isn't a pr-triage server — "
                f"stop it or pass a different --serve PORT", 1)


