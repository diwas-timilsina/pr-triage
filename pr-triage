        eprint(C.yellow(f"no server log yet ({LOG_PATH}) — it is written by `pr-triage serve`"))
        return 1
    with open(LOG_PATH, encoding="utf-8", errors="replace") as fh:
        lines = fh.readlines()
    for ln in lines[-max(1, opts.lines):]:
        print(ln.rstrip("\n"))
    if opts.follow:
        try:
            with open(LOG_PATH, encoding="utf-8", errors="replace") as fh:
                fh.seek(0, os.SEEK_END)
                while True:
                    ln = fh.readline()
                    if ln:
                        print(ln.rstrip("\n"), flush=True)
                    else:
                        time.sleep(0.5)
        except KeyboardInterrupt:
            pass
    return 0


def purge_cmd(opts) -> int:
    """`pr-triage purge [pr] [--yes]` — delete stored triages (one PR or all)."""
    key = None
    if opts.target:
        key = canon_pr_key(opts.target)
        if not key:
            die(f"can't parse PR reference for purge: {opts.target!r}", 2)
    label = key or "ALL stored triages"
    if not opts.yes:
        if not sys.stdin.isatty():
            die("purge needs --yes when not run interactively", 2)
        ans = input(f"purge {label}? [y/N] ").strip().lower()
        if ans not in ("y", "yes"):
            eprint("aborted")
            return 1
    # if a daemon is running, purge through it so memory and disk stay in sync
    state = read_serve_state()
    if state and state.get("port") and state.get("token"):
        daemon_up = False
        try:
            with urllib.request.urlopen(
                    f"http://127.0.0.1:{state['port']}/health", timeout=3) as resp:
                daemon_up = json.load(resp).get("app") == "pr-triage"
        except (OSError, ValueError):
            pass
        if daemon_up:
            req = urllib.request.Request(
                f"http://127.0.0.1:{state['port']}/purge", method="POST",
                data=json.dumps({"key": key}).encode("utf-8"),
                headers={"Content-Type": "application/json",
                         "X-PR-Triage-Token": state["token"]})
            try:
                with urllib.request.urlopen(req, timeout=15) as resp:
                    n = json.load(resp).get("purged", 0)
            except (OSError, ValueError) as e:
                die(f"purge via the running server failed: {e} "
                    "(old server build? restart `pr-triage serve` and retry)", 1)
            eprint(C.bold_green(f"purged {n} triage(s) from the running server"))
            return 0
    # no daemon: clean the datastore directly
    n = 0
    if key:
        path = _persist_path(key)
        if os.path.exists(path):
            try:
                os.remove(path)
                n = 1
            except OSError as e:
                die(f"could not remove {path}: {e}", 1)
    else:
        try:
            for name in os.listdir(STORE_DIR):
                if name.endswith(".json"):
                    os.remove(os.path.join(STORE_DIR, name))
                    n += 1
        except FileNotFoundError:
            pass
        except OSError as e:
            die(f"could not purge {STORE_DIR}: {e}", 1)
    eprint(C.bold_green(f"purged {n} stored triage(s) from {STORE_DIR}"))
    return 0


