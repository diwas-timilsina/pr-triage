      saveReviewed(reviewed); apply();
    });
  });
  bPri.addEventListener("click", function () { mode = "pri"; bPri.classList.add("on"); bOrd.classList.remove("on"); apply(); });
  bOrd.addEventListener("click", function () { mode = "ord"; bOrd.classList.add("on"); bPri.classList.remove("on"); apply(); });
  minscore.addEventListener("input", apply);
  shownoise.addEventListener("change", apply);
  document.getElementById("expall").addEventListener("click", function () {
    cards.forEach(function (c) { if (c.style.display !== "none") c.open = true; });
  });
  document.getElementById("colall").addEventListener("click", function () {
    cards.forEach(function (c) { c.open = false; });
  });
  apply();
})();
</script>
</body></html>
"""


def html_score_class(score: Optional[int]) -> str:
    if score is None:
        return "cold"
    if score >= 80:
        return "hot"
    if score >= 60:
        return "warm"
    if score >= 40:
        return "mid"
    return "cold"


def html_diff(body: str) -> str:
    out = []
    for ln in body.splitlines():
        esc = html_mod.escape(ln) or " "
        if ln.startswith("@@"):
            out.append(f'<span class="ln-hdr">{esc}</span>')
        elif ln.startswith("+"):
            out.append(f'<span class="ln-add">{esc}</span>')
        elif ln.startswith("-"):
            out.append(f'<span class="ln-del">{esc}</span>')
        else:
            out.append(f'<span class="ln-ctx">{esc}</span>')
    return "".join(out)


def stable_hid(h: Hunk) -> str:
    """Content-derived id for reviewed-state persistence: survives re-runs and
    goes stale (correctly) when the hunk's content changes on a new push."""
    digest = hashlib.sha1(
        f"{h.file}\n{h.header}\n{h.body}".encode("utf-8", "replace")).hexdigest()
    return "h" + digest[:12]


def _html_card(h: Hunk, pr_url: str, pri: int, ord_idx: int, body: str,
               file_label: str, is_noise: bool) -> str:
    pct = f"{h.importance}%" if h.importance is not None else "??"
    cls = html_score_class(h.importance)
    open_attr = " open" if (h.importance or 0) >= 70 and not is_noise else ""
    score = h.importance if h.importance is not None else -1
    gh = ""
    if pr_url:
        gh = (f'<a class="gh" href="{html_mod.escape(gh_hunk_url(pr_url, h))}" '
              f'target="_blank" rel="noopener">GitHub &#8599;</a>')
    notes = "".join(
        f'<span class="reason"><b>{label}</b> {html_mod.escape(text.replace(chr(10), " • "))}</span>'
        for label, text in (("what", h.what), ("why", h.why), ("tests", h.tests),
                            ("blast", h.blast), ("impression", h.verdict)) if text
    ) or (f'<span class="reason">{html_mod.escape(h.reason)}</span>' if h.reason else "")
    return (
        f'<details class="card"{open_attr} data-id="{stable_hid(h)}" '
        f'data-score="{score}" data-noise="{1 if is_noise else 0}" '
        f'data-pri="{pri}" data-ord="{ord_idx}"><summary>'
        f'<input type="checkbox" class="rev" title="mark reviewed">'
        f'<span class="badge {cls}">{pct}</span>'
        f'<span class="file">{html_mod.escape(file_label)}</span>'
        f'<span class="cat">{html_mod.escape(h.category or "?")}</span>'
        f"{gh}{notes}"
        f"</summary><pre>{html_diff(body)}</pre></details>"
    )


def render_html(meta: dict, hunks: list, opts) -> str:
    pr_url = meta.get("url") or ""
    ranked = sorted(hunks, key=lambda h: -(h.importance if h.importance is not None else -1))
    ord_of = {id(h): i for i, h in enumerate(hunks)}  # file order = discovery order
    signal = [h for h in ranked if not h.heuristic]
    noise = [h for h in ranked if h.heuristic]
    cards, pri = [], 0
    for h in signal:
        cards.append(_html_card(h, pr_url, pri, ord_of[id(h)],
                                h.body, f"{h.file}:{h.line_range}", False))
        pri += 1
    by_file: dict = {}
    for h in noise:
        by_file.setdefault(h.file, []).append(h)
    for file, hs in by_file.items():
        h0 = hs[0]
        count_s = f" · {len(hs)} hunks" if len(hs) > 1 else ""
        cards.append(_html_card(h0, pr_url, pri, ord_of[id(h0)],
                                "\n".join(h.body for h in hs), f"{file}{count_s}", True))
        pri += 1
    subs = {
        "__TITLE__": html_mod.escape(f"#{meta.get('number')} {meta.get('title', '')}"),
        "__URL__": html_mod.escape(pr_url),
        "__BRANCHES__": html_mod.escape(f"{meta.get('headRefName')} → {meta.get('baseRefName')}"),
        "__FILES__": html_mod.escape(str(meta.get("changedFiles"))),
        "__ADDS__": html_mod.escape(str(meta.get("additions"))),
        "__DELS__": html_mod.escape(str(meta.get("deletions"))),
        "__MODEL__": html_mod.escape(f" · {opts.model}" if opts.model else ""),
        "__TLDR__": (('<div class="tldr"><b>TL;DR</b>'
                      + "".join(f"<div>• {html_mod.escape(ln.strip())}</div>"
                                for ln in (meta.get("_triage_tldr") or "").split("\n")
                                if ln.strip())
                      + "</div>")
                     if meta.get("_triage_tldr") else ""),
        "__PR_KEY__": json.dumps(pr_url or f"pr-{meta.get('number')}").replace("<", "\\u003c"),
        "__CARDS__": "\n".join(cards),
    }
    # single pass: a token smuggled inside a value (e.g. a PR titled __CARDS__)
    # is emitted literally instead of being expanded by a later replacement
    return re.sub("|".join(map(re.escape, subs)), lambda m: subs[m.group(0)], HTML_TEMPLATE)


def write_html_report(path: str, meta: dict, hunks: list, opts):
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(render_html(meta, hunks, opts))


# ---------------------------------------------------------------------------
# Serve mode: a long-running local daemon holding triage results for many PRs.
# Feeds the GitHub-overlay userscript, hosts HTML reports, and accepts new PRs
# from its index page, from the overlay's "Triage this PR" button, and from
# `pr-triage <pr> --serve` runs (which publish into it instead of conflicting).
# ---------------------------------------------------------------------------

SERVE_STATE_PATH = os.path.expanduser("~/.local/state/pr-triage/serve.json")
STORE_DIR = os.path.expanduser("~/.local/state/pr-triage/store")


def _persist_path(key: str) -> str:
    return os.path.join(STORE_DIR, urllib.parse.quote(key, safe="") + ".json")


def persist_entry(key: str, entry: dict):
    """Write a finished triage to the local datastore (atomic, private)."""
    try:
        os.makedirs(STORE_DIR, exist_ok=True)
        done_reviews = {k: v for k, v in (entry.get("reviews") or {}).items()
                        if isinstance(v, dict) and v.get("status") == "done"}
        doc = {"key": key, "saved_at": time.strftime("%Y-%m-%d %H:%M"),
               "title": entry.get("title", ""), "url": entry.get("url", ""),
               "hunks": entry.get("hunks", 0), "reviews": done_reviews,
               "payload": entry.get("payload"), "html": entry.get("html", "")}
        path = _persist_path(key)
        fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(doc, fh)
        os.replace(path + ".tmp", path)
    except OSError as e:
        eprint(C.yellow(f"warning: could not persist triage of {key}: {e}"))


def delete_persisted(key: str):
    try:
        os.remove(_persist_path(key))
    except OSError:
        pass


def load_persisted() -> list:
    """Read saved triages, oldest first (so cap-eviction drops the oldest)."""
    try:
        names = [n for n in os.listdir(STORE_DIR) if n.endswith(".json")]
    except OSError:
        return []
    files = []
    for n in names:
        path = os.path.join(STORE_DIR, n)
        try:
            files.append((os.path.getmtime(path), path))
        except OSError:
            continue
    out = []
    for _, path in sorted(files):
        try:
            with open(path, encoding="utf-8") as fh:
                doc = json.load(fh)
            key = canon_pr_key(str(doc.get("key", "")))
            payload = doc.get("payload")
            if not key or not isinstance(payload, dict) or not isinstance(doc.get("html"), str):
                continue
            reviews = doc.get("reviews")
            out.append((key, {"status": "done", "title": str(doc.get("title") or ""),
                              "url": str(doc.get("url") or ""),
                              "hunks": int(doc.get("hunks") or 0),
                              "reviews": reviews if isinstance(reviews, dict) else {},
                              "payload": payload, "html": doc["html"], "error": "",
                              "saved": str(doc.get("saved_at") or "")}))
        except (OSError, json.JSONDecodeError, ValueError, TypeError):
            eprint(C.yellow(f"warning: skipping corrupt triage store file {path}"))
    return out


def read_serve_state() -> Optional[dict]:
    try:
        with open(SERVE_STATE_PATH, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError, ValueError):
        return None


def write_serve_state(state: dict):
    os.makedirs(os.path.dirname(SERVE_STATE_PATH), exist_ok=True)
    fd = os.open(SERVE_STATE_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(state, fh)


def build_review_prompt(payload: dict, hunk: dict, file_threads: list) -> str:
    """Prompt for the on-demand deep review of a single hunk."""
    pr = payload.get("pr") or {}
    parts = [
        "You are doing a careful second-pass code review of ONE diff hunk from a "
        "GitHub pull request. Draft ONLY feedback genuinely worth raising — real "
        "bugs, risks, missing tests, unclear intent. If nothing is worth raising, "
        "return empty lists. Never invent praise or filler comments.",
        "",
        f"PR: {pr.get('title', '')}",
        f"PR summary: {payload.get('tldr') or '(none)'}",
        f"File: {hunk.get('file')} (lines {hunk.get('lines')})",
        f"Triage notes — what: {hunk.get('what') or '-'} | why: {hunk.get('why') or '-'} "
        f"| tests: {hunk.get('tests') or '-'} | blast: {hunk.get('blast') or '-'} "
        f"| impression: {hunk.get('verdict') or hunk.get('reason') or '-'}",
        "",
        "=== DIFF ===",
        str(hunk.get("diff") or "")[:20000],
    ]
    if file_threads:
        parts += ["", "=== EXISTING REVIEW THREADS ON THIS FILE (id · line · author · text) ==="]
        for c in file_threads[:40]:
            tag = f"(reply to {c['reply_to']})" if c.get("reply_to") else f"[id {c.get('id')}]"
            parts.append(f"{tag} line {c.get('line')} · {c.get('user')}: {str(c.get('body'))[:500]}")
    parts += [
        "",
        "Respond with JSON only — no markdown fences, no prose — matching exactly:",
        '{"comments":[{"line":<int, NEW-file line number inside this hunk>,'
        '"severity":"blocker|question|suggestion|nit",'
        '"comment":"<the review comment, specific and concise>"}],'
        '"replies":[{"reply_to_id":<int, id of the thread root comment>,'
        '"reply":"<draft reply — ONLY for threads whose latest message asks something '
        'or where new information warrants a response>"}]}',
    ]
    return "\n".join(parts)


def build_chat_prompt(payload: dict, hunk: Optional[dict], file_threads: list,
                      messages: list) -> str:
    """Prompt for the reviewer chat — whole-PR context, or one hunk in focus."""
    pr = payload.get("pr") or {}
    parts = [
        "You are a code-review assistant chatting with a human reviewer about a "
        "GitHub pull request. Answer the reviewer's last message directly and "
        "concisely, in plain text (no markdown headings, no bullet spam). Ground "
        "every claim in the provided context; when something is outside it, say so "
        "plainly instead of guessing.",
        "",
        f"PR: {pr.get('title', '')} ({pr.get('url', '')})",
        f"Summary: {payload.get('tldr') or '(none)'}",
    ]
    if hunk is not None:
        parts += [
            "",
            f"FOCUS DIFF — {hunk.get('file')}:{hunk.get('lines')} "
            f"(importance {hunk.get('importance')}%, {hunk.get('category')})",
            f"what: {hunk.get('what') or '-'} | why: {hunk.get('why') or '-'} | "
            f"tests: {hunk.get('tests') or '-'} | blast: {hunk.get('blast') or '-'} | "
            f"impression: {hunk.get('verdict') or hunk.get('reason') or '-'}",
            "=== DIFF ===",
            str(hunk.get("diff") or "")[:20000],
        ]
        if file_threads:
            parts += ["", "=== REVIEW THREADS ON THIS FILE ==="]
            for c in file_threads[:30]:
                parts.append(f"line {c.get('line')} · {c.get('user')}: {str(c.get('body'))[:400]}")
    else:
        scored = [h for h in payload.get("hunks", []) if not h.get("heuristic")]
        parts += ["", "=== CHANGES BY PRIORITY (score · file:lines · verdict) ==="]
        for h in scored[:150]:
            parts.append(f"{h.get('importance')}% · {h.get('file')}:{h.get('lines')} · "
                         f"{(h.get('verdict') or h.get('reason') or '')[:120]}")
        parts += ["", "=== TOP DIFF EXCERPTS ==="]
        for h in scored[:8]:
            parts += [f"--- {h.get('file')}:{h.get('lines')}",
                      str(h.get("diff") or "")[:2500]]
    parts += ["", "=== CONVERSATION ==="]
    for m in messages[-20:]:
        role = "Reviewer" if m.get("role") == "user" else "Assistant"
        parts.append(f"{role}: {str(m.get('text'))[:4000]}")
    parts += ["", "Reply to the reviewer's last message. Plain text only — no JSON."]
    return "\n".join(parts)


def slim_review(payload: dict) -> dict:
    """Validate/trim a model deep-review response."""
    comments, replies = [], []
    for c in (payload.get("comments") or [])[:10]:
        if not isinstance(c, dict):
            continue
        try:
            line = int(c.get("line"))
        except (TypeError, ValueError):
            line = 0
        sev = str(c.get("severity") or "suggestion")
        if sev not in ("blocker", "question", "suggestion", "nit"):
            sev = "suggestion"
        text = str(c.get("comment") or "").strip()[:1000]
        if text:
            comments.append({"line": line, "severity": sev, "comment": text})
    for r in (payload.get("replies") or [])[:10]:
        if not isinstance(r, dict):
            continue
        try:
            rid = int(r.get("reply_to_id"))
        except (TypeError, ValueError):
            continue
        text = str(r.get("reply") or "").strip()[:1000]
        if text:
            replies.append({"reply_to_id": rid, "reply": text})
    return {"comments": comments, "replies": replies}


