def gh_file_anchor(path: str) -> str:
    """GitHub 'Files changed' anchor for a file: diff-<sha256 hex of new path>."""
    if " -> " in path:
        path = path.split(" -> ")[-1]
    return "diff-" + hashlib.sha256(path.encode("utf-8")).hexdigest()


def gh_hunk_url(pr_url: str, h: Hunk) -> str:
    """Deep link to this hunk on the real GitHub PR 'Files changed' page."""
    anchor = gh_file_anchor(h.file)
    if h.header and h.new_start > 0:
        anchor += f"R{h.new_start}"
    return f"{pr_url}/files#{anchor}"


def hunk_dict(h: Hunk, pr_url: str = "") -> dict:
    return {
        "id": h.hid, "file": h.file, "status": h.file_status,
        "lines": h.line_range, "added": h.added, "removed": h.removed,
        "importance": h.importance, "category": h.category,
        "reason": h.reason, "what": h.what, "why": h.why,
        "tests": h.tests, "blast": h.blast, "verdict": h.verdict,
        "heuristic": h.heuristic, "diff": h.body,
        "anchor": gh_file_anchor(h.file),
        "gh_url": gh_hunk_url(pr_url, h) if pr_url else "",
    }


def build_report_doc(meta: dict, hunks: list, opts, cost: float) -> dict:
    ranked = sorted(hunks, key=lambda h: -(h.importance if h.importance is not None else -1))
    pr_url = meta.get("url") or ""
    return {
        "pr": {k: meta.get(k) for k in
               ("number", "title", "url", "baseRefName", "headRefName",
                "additions", "deletions", "changedFiles", "state")},
        "model": opts.model,
        "api_cost_usd": cost,
        "tldr": meta.get("_triage_tldr") or "",
        "impression": meta.get("_triage_impression") or "",
        "approvability": meta.get("_triage_approvability"),
        "approve_signal": meta.get("_triage_approve_signal") or "",
        "comments": meta.get("_triage_comments") or [],
        "hunks": [hunk_dict(h, pr_url) for h in ranked],
    }


def write_json_report(path: str, meta: dict, hunks: list, opts, cost: float):
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(build_report_doc(meta, hunks, opts, cost), fh, indent=2)


