def bar(score: Optional[int], width: int = 10) -> str:
    if score is None:
        return "?" * width
    filled = round(score / 100 * width)
    return "█" * filled + "░" * (width - filled)


def colorize_diff_line(line: str) -> str:
    if line.startswith("@@"):
        return C.cyan(line)
    if line.startswith("+"):
        return C.green(line)
    if line.startswith("-"):
        return C.red(line)
    return C.dim(line)


def render_terminal(meta: dict, files: list, hunks: list, opts,
                    elapsed: float, cost: float, warnings: list):
    width = min(shutil.get_terminal_size((100, 24)).columns, 120)
    ranked = sorted(hunks, key=lambda h: (-(h.importance if h.importance is not None else -1),
                                          -(h.added + h.removed)))
    scored = [h for h in ranked if h.importance is not None]
    noise = [h for h in ranked if h.heuristic]
    signal = [h for h in scored if not h.heuristic]

    author = (meta.get("author") or {}).get("login", "?")
    print()
    print(C.bold(f"PR #{meta.get('number')} — {meta.get('title', '')}"))
    print(C.dim(f"{meta.get('url', '')}"))
    print(C.dim(f"by {author} · {meta.get('headRefName')} -> {meta.get('baseRefName')} · "
                f"{meta.get('changedFiles')} files · +{meta.get('additions')}/-{meta.get('deletions')}"))
    tldr = (meta.get("_triage_tldr") or "").strip()
    if tldr:
        print()
        print(C.bold("TL;DR"))
        for ln in tldr.split("\n"):
            if ln.strip():
                print(f"  • {ln.strip()}")
    impression = (meta.get("_triage_impression") or "").strip()
    if impression:
        print(C.bold("IMPRESSION"))
        for ln in impression.split("\n"):
            if ln.strip():
                print(f"  • {ln.strip()}")
    appr = meta.get("_triage_approvability")
    if appr is not None:
        col = C.bold_green if appr >= 80 else (C.bold_yellow if appr >= 55 else C.bold_red)
        sig = (meta.get("_triage_approve_signal") or "").strip()
        print(f"{C.bold('APPROVABILITY')} {col(f'{appr}%')}" + (f" — {sig}" if sig else ""))
    print()

    # ---- summary table (model-scored hunks; heuristic noise grouped below) ----
    table_hunks = [h for h in ranked if not h.heuristic]
    print(C.bold("REVIEW PRIORITY"))
    print(C.dim("─" * width))
    for i, h in enumerate(table_hunks, 1):
        col = score_color(h.importance)
        pct = f"{h.importance:3d}%" if h.importance is not None else "  ??"
        loc = f"{h.file}:{h.line_range}"
        cat = f"[{h.category or '?'}]"
        line1 = f"{i:3d}. {col(bar(h.importance))} {col(pct)}  {C.bold(loc)} {C.magenta(cat)}"
        print(line1)
        if h.reason:
            print(f"     {C.dim(h.reason)}")
    print()

    # ---- detailed prioritized diff ----
    detail = [h for h in signal if h.importance is not None and h.importance >= opts.min_score]
    if opts.top is not None:
        detail = detail[:max(0, opts.top)]
    unscored = [h for h in ranked if h.importance is None]

    if detail:
        print(C.bold("PRIORITIZED DIFF") + C.dim(
            f"  (top {len(detail)} of {len(hunks)} hunks"
            + (f", min score {opts.min_score}%" if opts.min_score else "") + ")"))
        for rank, h in enumerate(detail, 1):
            col = score_color(h.importance)
            print()
            print(C.dim("═" * width))
            print(f"#{rank} · {col(f'{h.importance}%')} · {C.magenta(h.category)} · "
                  f"{C.bold(h.file)} {C.dim('(' + h.file_status + ')')}")
            def note(label, value):
                lines = [x.strip() for x in value.split("\n") if x.strip()]
                if not lines:
                    return
                print(f"   {C.bold((label + ':').ljust(12))} {lines[0]}")
                for extra in lines[1:]:
                    print(f"   {'':<12} • {extra}")

            note("what", h.what)
            note("why", h.why)
            note("tests", h.tests)
            note("blast", h.blast)
            if h.verdict:
                lines = [x.strip() for x in h.verdict.split("\n") if x.strip()]
                print(C.yellow(f"   {'impression:':<12} {lines[0]}"))
                for extra in lines[1:]:
                    print(C.yellow(f"   {'':<12} • {extra}"))
            if not (h.what or h.why or h.verdict) and h.reason:
                print(C.yellow(f"   note: {h.reason}"))
            print()
            for ln in h.body.splitlines():
                print("  " + colorize_diff_line(ln))

    if unscored:
        print()
        print(C.bold_yellow(f"UNSCORED ({len(unscored)} hunks — model skipped them; shown unranked)"))
        for h in unscored:
            print(f"  · {h.file}:{h.line_range} ({h.added}+/{h.removed}-)")

    if noise:
        by_file: dict = {}
        for h in noise:
            entry = by_file.setdefault(h.file, [h.importance, h.reason, 0])
            entry[2] += 1
        print()
        print(C.bold(f"LOW-PRIORITY / NOISE ({len(noise)} hunks in {len(by_file)} files, auto-classified)"))
        for file, (imp, reason, count) in by_file.items():
            hunks_s = f" ({count} hunks)" if count > 1 else ""
            print(C.dim(f"  · {imp:2d}% {file}{hunks_s} — {reason}"))

    print()
    print(C.dim("─" * width))
    cost_s = f" · api cost ${cost:.4f}" if cost else ""
    model_s = f" · model {opts.model}" if opts.model else ""
    print(C.dim(f"scored {len(signal)} hunks with claude, {len(noise)} by heuristics "
                f"in {elapsed:.1f}s{model_s}{cost_s}"))
    for w in warnings:
        eprint(C.yellow(f"warning: {w}"))


