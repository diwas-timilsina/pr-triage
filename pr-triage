def build_arg_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="pr-triage",
        description="Prioritize a GitHub PR's diff for human review using local Claude.",
        epilog="PR reference forms: https://github.com/owner/repo/pull/N · owner/repo#N · N --repo owner/repo",
    )
    p.add_argument("pr", help="PR URL, owner/repo#N, bare number with --repo — or a "
                              "subcommand: 'serve' (run the triage server), 'logs' "
                              "(show server logs), 'purge' (delete stored triages)")
    p.add_argument("target", nargs="?",
                   help="for 'purge': the PR to purge (omit to purge everything)")
    p.add_argument("-n", "--lines", type=int, default=100, metavar="N",
                   help="for 'logs': number of trailing lines to show (default 100)")
    p.add_argument("-f", "--follow", action="store_true",
                   help="for 'logs': keep following new log lines (Ctrl-C to stop)")
    p.add_argument("--yes", action="store_true",
                   help="for 'purge': skip the confirmation prompt")
    p.add_argument("--repo", help="owner/name (for bare PR numbers)")
    p.add_argument("--model", help="model passed to `claude --model` (default: your claude default)")
    p.add_argument("--top", type=int, metavar="N", help="show only the top N hunks in the detailed diff view")
    p.add_argument("--min-score", type=int, default=0, metavar="PCT",
                   help="hide hunks below this importance in the detailed view (default 0)")
    p.add_argument("--batch-chars", type=int, default=60000, metavar="N",
                   help="max prompt chars per claude call (default 60000)")
    p.add_argument("--parallel", type=int, default=2, metavar="N",
                   help="concurrent claude calls (default 2; use 1 for slow local models)")
    p.add_argument("--timeout", type=int, default=600, metavar="SECS",
                   help="per-call timeout (default 600)")
    p.add_argument("--auto-review", type=int, default=12, metavar="N",
                   help="serve: after each triage, pre-generate deep reviews for the top N "
                        "hunks at or above --auto-review-min, so 'Review this diff' is "
                        "instant for them (0 disables; default 12)")
    p.add_argument("--auto-review-min", type=int, default=50, metavar="PCT",
                   help="serve: importance threshold for auto deep-reviews (default 50)")
    p.add_argument("--no-heuristics", action="store_true",
                   help="send lockfiles/generated/binary changes to the model too")
    p.add_argument("--json", metavar="PATH", help="also write a JSON report")
    p.add_argument("--html", metavar="PATH", help="also write a self-contained HTML report")
    p.add_argument("--serve", nargs="?", const=8642, type=int, metavar="PORT",
                   help="after scoring, start the triage server on 127.0.0.1 (default port "
                        "8642) — or publish this result into an already-running one. The "
                        "server hosts a dashboard, HTML reports, and the overlay JSON, and "
                        "accepts more PRs from the dashboard or the GitHub overlay button")
    p.add_argument("--no-color", action="store_true", help="disable ANSI colors")
    p.add_argument("--claude-bin", default="claude", help="claude executable (default: claude)")
    p.add_argument("--claude-arg", action="append", metavar="ARG",
                   help="extra args passed through to claude, shell-style split "
                        "(repeatable; use = for flag-like values: --claude-arg=--verbose, "
                        "--claude-arg '--effort low')")
    p.add_argument("--dry-run", action="store_true",
                   help="parse + batch only; print what would be sent, don't call claude")
    p.add_argument("-v", "--verbose", action="store_true")
    return p


def main(argv=None) -> int:
    opts = build_arg_parser().parse_args(argv)
    if opts.no_color or os.environ.get("NO_COLOR") or not sys.stdout.isatty():
        C.enabled = False
    if os.sep in opts.claude_bin:
        # claude runs from a temp cwd; keep relative binary paths working
        opts.claude_bin = os.path.abspath(opts.claude_bin)
    if opts.top is not None and opts.top < 0:
        die("--top must be >= 0", 2)
    # fail fast on unwritable report paths, before any gh/claude work
    for flag, p in (("--json", opts.json), ("--html", opts.html)):
        if p:
            if os.path.isdir(p):
                die(f"{flag} path is a directory: {p}", 2)
            parent = os.path.dirname(os.path.abspath(p))
            if not os.path.isdir(parent):
                die(f"{flag} parent directory does not exist: {parent}", 2)

    cmd = opts.pr.strip().lower()
    if cmd == "help":
        build_arg_parser().print_help()
        print(SUBCOMMAND_HELP)
        return 0
    if cmd == "logs":
        return logs_cmd(opts)
    if cmd == "purge":
        return purge_cmd(opts)
    if opts.target:
        die(f"unexpected extra argument: {opts.target!r}", 2)
    if cmd == "serve":
        # daemon mode: start empty; PRs are added from the dashboard, the
        # overlay's "Triage this PR" button, or `pr-triage <pr> --serve` runs
        try:
            daemon_serve(opts.serve if opts.serve is not None else 8642, opts, [])
        except ToolError as e:
            die(str(e), e.code)
        return 0

    repo, num = parse_pr_ref(opts.pr, opts.repo)
    pr_key = f"{repo.lower()}#{num}"
    t0 = time.time()
    try:
        meta, files, all_hunks, to_score, warnings = prepare_triage(repo, num, opts)
    except ToolError as e:
        die(str(e), e.code)
    if not files:
        eprint(C.yellow("PR diff is empty — nothing to triage"))
        if opts.json:
            write_json_report(opts.json, meta, [], opts, 0.0)
        if opts.html:
            write_html_report(opts.html, meta, [], opts)
        if opts.serve is not None:
            serve_or_publish(opts.serve, pr_key, build_report_doc(meta, [], opts, 0.0),
                             render_html(meta, [], opts), opts)
        return 0

    if opts.dry_run:
        batches = batch_hunks(to_score, opts.batch_chars)
        print(f"{len(files)} files, {len(all_hunks)} hunks "
              f"({len(to_score)} to score, {len(all_hunks) - len(to_score)} heuristic)")
        for i, b in enumerate(batches, 1):
            prompt = build_prompt(meta, b)
            print(f"  batch {i}: {len(b)} hunks, {len(prompt)} prompt chars")
        return 0

    try:
        total_cost = score_hunks(to_score, meta, opts, warnings)
    except ClaudeError as e:
        die(str(e), 4)

    elapsed = time.time() - t0
    render_terminal(meta, files, all_hunks, opts, elapsed, total_cost, warnings)

    rc = 0
    if opts.json:
        try:
            write_json_report(opts.json, meta, all_hunks, opts, total_cost)
            eprint(C.dim(f"json report: {opts.json}"))
        except OSError as e:
            eprint(C.red(f"pr-triage: failed to write json report {opts.json!r}: {e}"))
            rc = 1
    if opts.html:
        try:
            write_html_report(opts.html, meta, all_hunks, opts)
            eprint(C.dim(f"html report: {opts.html}"))
        except OSError as e:
            eprint(C.red(f"pr-triage: failed to write html report {opts.html!r}: {e}"))
            rc = 1
    if opts.serve is not None:
        serve_or_publish(opts.serve, pr_key, build_report_doc(meta, all_hunks, opts, total_cost),
                         render_html(meta, all_hunks, opts), opts)
    return rc


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        eprint("\ninterrupted")
        sys.exit(130)
